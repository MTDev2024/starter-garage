---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
  class?: string;
}

const { eyebrow, title, description, align = "left", tone = "light", class: className = "" } = Astro.props;

const alignClass = align === "center" ? "items-center text-center mx-auto" : "items-start text-left";
const descColor = tone === "dark" ? "text-text-on-dark-muted" : "text-text-muted";
const eyebrowColor = tone === "dark" ? "text-brand-on-dark" : "text-brand";
const titleColor = tone === "dark" ? "text-text-on-dark" : "text-ink";
---

<div class:list={["flex max-w-2xl flex-col gap-3", alignClass, className]}>
  {
    eyebrow && (
      <span class:list={["font-heading text-sm font-semibold uppercase tracking-wider", eyebrowColor]}>
        {eyebrow}
      </span>
    )
  }
  <h2 class:list={["font-heading text-3xl font-bold leading-tight sm:text-4xl", titleColor]}>{title}</h2>
  {description && <p class:list={["text-base leading-relaxed", descColor]}>{description}</p>}
</div>
