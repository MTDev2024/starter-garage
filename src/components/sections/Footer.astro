---
import { client } from "../../config/client";
import Icon from "../Icon.astro";
import Container from "../ui/Container.astro";

const { footer, meta, contact } = client;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-text-on-dark">
  <Container as="div" class="grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-4">
      <p class="font-heading text-2xl font-extrabold text-text-on-dark">
        {meta.name}<span class="text-brand">.</span>
      </p>
      <p class="max-w-xs text-sm leading-relaxed text-text-on-dark-muted">{footer.description}</p>
      <ul class="flex gap-3">
        {
          footer.social.map((link) => (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                class="flex size-10 items-center justify-center rounded-pill bg-ink-soft text-text-on-dark transition-colors hover:bg-brand"
              >
                <Icon name={link.icon} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      footer.linkGroups.map((group) => (
        <nav aria-label={group.title}>
          <h3 class="font-heading text-sm font-semibold uppercase tracking-wide text-text-on-dark">
            {group.title}
          </h3>
          <ul class="mt-4 flex flex-col gap-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-text-on-dark-muted transition-colors hover:text-brand">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div>
      <h3 class="font-heading text-sm font-semibold uppercase tracking-wide text-text-on-dark">Horaires</h3>
      <ul class="mt-4 flex flex-col gap-2 text-sm text-text-on-dark-muted">
        {
          contact.hours.map((row) => (
            <li class="flex justify-between gap-4">
              <span>{row.days}</span>
              <span>{row.hours}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container as="div" class="flex flex-col items-center justify-between gap-3 py-6 text-xs text-text-on-dark-muted sm:flex-row">
      <p>© {year} {footer.copyright}</p>
      <p>{contact.addressLine1}, {contact.addressLine2}</p>
    </Container>
  </div>
</footer>
