---
import { Image } from "astro:assets";
import { client } from "../../config/client";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../Icon.astro";

const { services } = client;
---

<section id="services" class="py-20 lg:py-28">
  <Container as="div" class="flex flex-col gap-12">
    <SectionHeading eyebrow={services.eyebrow} title={services.title} align="center" class="mx-auto" />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.items.map((service) =>
          service.featuredImage ? (
            <a
              href={service.href}
              class="group relative flex min-h-80 flex-col justify-end overflow-hidden rounded-card p-8 shadow-card"
            >
              <Image
                src={service.featuredImage}
                alt={service.featuredImageAlt ?? ""}
                width={500}
                height={500}
                class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 -z-10 bg-ink/70" aria-hidden="true" />
              <span class="font-heading text-sm font-semibold text-brand-on-dark">Service {service.index}</span>
              <h3 class="mt-2 font-heading text-2xl font-bold text-text-on-dark">{service.title}</h3>
              <p class="mt-2 text-sm text-text-on-dark-muted">{service.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 font-heading text-sm font-semibold text-text-on-dark">
                En savoir plus
                <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ) : (
            <a
              href={service.href}
              class="group flex min-h-80 flex-col justify-between rounded-card border border-border bg-surface p-8 shadow-card transition-colors hover:border-brand"
            >
              <div class="flex items-start justify-between">
                <span class="flex size-14 items-center justify-center rounded-card bg-brand-light text-brand">
                  <Icon name={service.icon} class="size-7" />
                </span>
                <span class="font-heading text-sm font-semibold text-text-muted">Service {service.index}</span>
              </div>
              <div class="mt-6">
                <h3 class="font-heading text-2xl font-bold text-ink">{service.title}</h3>
                <p class="mt-2 text-sm text-text-muted">{service.description}</p>
                <span class="mt-4 inline-flex items-center gap-2 font-heading text-sm font-semibold text-ink group-hover:text-brand">
                  En savoir plus
                  <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          ),
        )
      }
    </div>
  </Container>
</section>
