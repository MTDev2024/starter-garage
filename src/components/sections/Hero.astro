---
import { Image } from "astro:assets";
import { client } from "../../config/client";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

const { hero } = client;
---

<section id="accueil" class="relative overflow-hidden bg-surface-muted">
  <Container as="div" class="grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <div class="flex flex-col gap-6">
      <span class="w-fit rounded-pill bg-brand-light px-4 py-1.5 font-heading text-sm font-semibold text-brand-dark">
        {hero.eyebrow}
      </span>
      <h1 class="font-heading text-4xl font-extrabold leading-[1.1] text-ink sm:text-5xl lg:text-6xl">
        {hero.titleLines.map((line) => <span class="block">{line}</span>)}
        <span class="block text-brand">{hero.highlightWord}</span>
      </h1>
      <p class="max-w-lg text-lg leading-relaxed text-text-muted">{hero.description}</p>
      <div class="flex flex-wrap gap-4">
        <Button href={hero.primaryCta.href} size="lg">{hero.primaryCta.label}</Button>
        <Button href={hero.secondaryCta.href} variant="ghost" size="lg" icon="phone">
          {hero.secondaryCta.label}
        </Button>
      </div>
      <ul class="mt-4 flex flex-wrap gap-x-10 gap-y-4">
        {
          hero.stats.map((stat) => (
            <li>
              <p class="font-heading text-2xl font-extrabold text-ink">{stat.value}</p>
              <p class="text-sm text-text-muted">{stat.label}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <div class="absolute -inset-4 -z-10 rounded-lg bg-ink/5 sm:-inset-8" aria-hidden="true"></div>
      <Image
        src={hero.image}
        alt={hero.imageAlt}
        width={640}
        height={760}
        class="aspect-[4/5] w-full rounded-lg object-cover shadow-card"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </Container>
</section>
