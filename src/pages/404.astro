---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Page introuvable" noIndex>
  <Container as="div" class="flex min-h-[60vh] flex-col items-center justify-center gap-6 py-20 text-center">
    <p class="font-heading text-sm font-semibold uppercase tracking-wider text-brand">Erreur 404</p>
    <h1 class="font-heading text-4xl font-extrabold text-ink">Cette page n'existe pas</h1>
    <p class="max-w-md text-text-muted">La page que vous cherchez a peut-être été déplacée ou n'existe plus.</p>
    <Button href="/">Retour à l'accueil</Button>
  </Container>
</Layout>
