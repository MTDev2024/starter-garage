---
import "@fontsource-variable/sora";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { client } from "../config/client";
import { buildLocalBusinessSchema } from "../lib/seo";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Set true on utility pages (ex: 404) to keep them out of search results. */
  noIndex?: boolean;
}

const { title, description = client.seo.defaultDescription, noIndex = false } = Astro.props;

const pageTitle = title ? client.seo.titleTemplate.replace("%s", title) : client.seo.defaultTitle;
const canonicalUrl = new URL(Astro.url.pathname, client.meta.url).toString();
const ogImageUrl = new URL(client.seo.ogImage.src, Astro.site ?? client.meta.url).toString();
const jsonLd = buildLocalBusinessSchema();
---

<!doctype html>
<html lang={client.meta.locale.split("-")[0]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={client.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={client.theme.colors.ink} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-surface text-text">
    <a href="#contenu" class="skip-link">Aller au contenu principal</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
